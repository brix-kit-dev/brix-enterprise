# Brix Enterprise npm Configuration
# ============================================================================
# IMPORTANT: Configure GitLab private registry access.
#
# To authenticate with GitLab:
# 1. Generate a Personal Access Token with read_api scope
# 2. Set GITLAB_TOKEN environment variable
# 3. Or add token directly (not recommended for shared machines)
#
# Example:
# //gitlab.example.com/api/v4/packages/npm/:_authToken=${GITLAB_TOKEN}
# ============================================================================

# Hoist dependencies
shamefully-hoist=true

# Strict peer dependencies
strict-peer-dependencies=false

# Auto-install peers
auto-install-peers=true

# Registry configuration (uncomment and configure)
# @brix-sdk:registry=https://gitlab.example.com/api/v4/packages/npm/
