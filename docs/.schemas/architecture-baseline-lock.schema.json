{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brix.io/schemas/architecture-baseline-lock.schema.json",
  "title": "Brix Architecture Baseline Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselines"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/baseline"
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reviewer", "recordRef", "approvedAt"],
      "properties": {
        "role": {
          "enum": ["architecture-committee", "security", "sre"]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:CHANGE-ME|TBD|TODO|PLACEHOLDER)).+$"
        },
        "recordRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:CHANGE-ME|TBD|TODO|PLACEHOLDER)).+$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "version",
        "compatibilityEpoch",
        "status",
        "effective",
        "gitCommit",
        "sha256",
        "approvals",
        "effectiveDate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^docs/[^/]+\\.md$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "compatibilityEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": ["pending-approval", "architecture-frozen"]
        },
        "effective": {
          "type": "boolean"
        },
        "gitCommit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          }
        },
        "effectiveDate": {
          "type": ["string", "null"],
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "architecture-frozen"
              }
            }
          },
          "then": {
            "properties": {
              "effective": {
                "const": true
              },
              "gitCommit": {
                "type": "string"
              },
              "effectiveDate": {
                "type": "string"
              },
              "approvals": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "else": {
            "properties": {
              "effective": {
                "const": false
              },
              "gitCommit": {
                "const": null
              },
              "effectiveDate": {
                "const": null
              },
              "approvals": {
                "maxItems": 2
              }
            }
          }
        }
      ]
    }
  }
}