{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brix.io/schemas/architecture-exemptions.schema.json",
  "title": "Brix Architecture Temporary Exemptions (BRX-RS-GOVERNANCE-013)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exemptions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "exemptions": {"type": "array", "items": {"$ref": "#/$defs/exemption"}}
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:CHANGE-ME|TBD|TODO|PLACEHOLDER)).+$"
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "recordRef", "approvedAt"],
      "properties": {
        "reviewer": {"$ref": "#/$defs/text"},
        "recordRef": {"$ref": "#/$defs/text"},
        "approvedAt": {"type": "string", "format": "date-time"}
      }
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "ruleIds", "artifacts", "owner", "reason", "risk",
        "compensatingControls", "expiresOn", "exitCriteria", "approval"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^EX-[0-9]{4}-[0-9]{3}$"},
        "title": {"$ref": "#/$defs/text"},
        "ruleIds": {"$ref": "#/$defs/textList"},
        "artifacts": {"$ref": "#/$defs/textList"},
        "owner": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "risk": {"$ref": "#/$defs/text"},
        "compensatingControls": {"$ref": "#/$defs/textList"},
        "expiresOn": {"type": "string", "format": "date"},
        "exitCriteria": {"$ref": "#/$defs/text"},
        "approval": {"$ref": "#/$defs/approval"}
      }
    }
  }
}
