{
  "name": "@brix-sdk/enterprise-monorepo",
  "version": "3.2.0",
  "private": true,
  "description": "Brix Enterprise - Commercial Extensions (PROPRIETARY)",
  "keywords": [
    "brix",
    "enterprise",
    "commercial",
    "proprietary"
  ],
  "author": "Brix Platform Authors",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git@gitlab.example.com:brix/brix-enterprise.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "node ../brix/scripts/lint-configured-packages.mjs --skip @brix-sdk/enterprise-carousel-app --skip @brix-sdk/enterprise-contracts-app --skip @brix-sdk/enterprise-identity-app --skip @brix-sdk/enterprise-messenger-app --skip @brix-sdk/enterprise-partners-app --skip @brix-sdk/enterprise-products-app --skip @brix-sdk/enterprise-storage-app --skip @brix-sdk/app-tenant",
    "architecture:validate": "python3 scripts/validate_architecture_baseline.py --require-active --check-instructions",
    "frontend:phase0:inventory": "python3 scripts/frontend_phase0_inventory.py --write-report docs/phase0-evidence/frontend-phase0-inventory.md --write-json docs/phase0-evidence/frontend-phase0-inventory.json",
    "frontend:gate:route-snapshot": "python3 scripts/frontend_phase0_inventory.py --gate frontend-route-snapshot --fail-on-violations",
    "frontend:gate:layered-arch": "python3 scripts/frontend_phase0_inventory.py --gate frontend-layered-arch --fail-on-violations",
    "frontend:gate:release-artifact": "python3 scripts/frontend_release_artifact_gate.py",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "build:shared": "pnpm -r --filter \"./packages/@brix/enterprise-solutions/*/*-shared\" run build",
    "typecheck": "python3 scripts/frontend_typecheck_baseline.py",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish",
    "prepare": "echo 'Brix Enterprise workspace ready'"
  },
  "devDependencies": {
    "@brix-sdk/shared-runtime-web": "link:../brix/packages/@brix/shared-runtime/shared-runtime-web",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@brix-sdk/shared-runtime-web"
      ]
    },
    "overrides": {
      "@brix-sdk/shared-runtime-web": "link:../brix/packages/@brix/shared-runtime/shared-runtime-web",
      "@brix-sdk/runtime-sdk-react": "link:../brix/packages/@brix/runtime-sdk/runtime-sdk-react",
      "@brix-sdk/runtime-sdk-api-web": "link:../brix/packages/@brix/runtime-sdk/runtime-sdk-api-web",
      "@brix-sdk/platform-tenant-web": "link:../brix/packages/@brix/platform-commons/packages/client/platform-tenant-web"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
