{
  "name": "@shinwa/shinwa-platform",
  "version": "3.1.0",
  "private": true,
  "description": "Shinwa Platform 私有商业模块 - 登录基座、品牌定制等（非开源）",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --config eslint.config.cjs .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@changesets/changelog-github": "^0.5.0",
    "@brix/eslint-config-architecture": "^3.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "author": "Brix Platform Authors",
  "license": "PROPRIETARY"
}
