{
  "name": "@shinwa/shinwa-platform-shell-web",
  "version": "3.0.0",
  "private": true,
  "description": "Shinwa Web 登录基座 - 提供预装配的 Shell 页面、布局能力（非开源）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pages": {
      "import": "./dist/pages/index.js",
      "types": "./dist/pages/index.d.ts"
    },
    "./layouts": {
      "import": "./dist/layouts/index.js",
      "types": "./dist/layouts/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brix/design-tokens": "link:../../platform-devtools/@brix/design-tokens",
    "@brix/infra-adapter-mf-web": "link:../../infra-adapters/packages/web/infra-adapter-mf-web",
    "@brix/platform-auth-web": "link:../../platform-commons/packages/client/platform-auth-web",
    "@brix/platform-navigation-web": "link:../../platform-commons/packages/client/platform-navigation-web",
    "@brix/runtime-sdk-api-web": "link:../../runtime-sdk/runtime-sdk-api-web",
    "@brix/runtime-sdk-react": "link:../../runtime-sdk/runtime-sdk-react"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "react": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "shinwa",
    "platform",
    "shell",
    "layout",
    "web",
    "login"
  ],
  "author": "Brix Platform Authors",
  "license": "PROPRIETARY",
  "sideEffects": false
}
