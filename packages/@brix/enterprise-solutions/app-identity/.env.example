# ============================================================
# Identity Module - Environment Variables Configuration Template
# ============================================================
#
# Usage:
#   1. Copy this file to .env
#   2. Modify configuration values below
#   3. .env file is in .gitignore and will not be committed
#
# Security Warning:
#   - Do NOT commit real passwords to version control
#   - Use Secrets Manager or Vault in production
#
# ============================================================

# ==================== PostgreSQL ====================
POSTGRES_USER=brix
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=brix_platform

# ==================== Database Connection (Application Usage) ====================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=brix
DB_PASSWORD=your-secure-password-here
DB_NAME=brix_platform

# ==================== JWT ====================
JWT_SECRET=your-jwt-secret-key-here-at-least-32-characters

# ==================== Google OAuth2 (Optional) ====================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
