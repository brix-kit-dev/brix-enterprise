{
  "name": "@brix-sdk/enterprise-identity-app",
  "version": "3.2.0",
  "private": true,
  "description": "身份认证应用 - v3.0 Manifest-Driven 架构",
  "scripts": {
    "generate:api": "pnpm --filter @brix-sdk/enterprise-identity-shared generate:api",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @brix-sdk/enterprise-identity-shared build",
    "build:web": "pnpm --filter @brix-sdk/enterprise-identity-web build",
    "dev:web": "pnpm --filter @brix-sdk/enterprise-identity-web start",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  }
}
