<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  booking-server - 预约模块服务层
  
  职责：
  - REST Controller（API 端点）
  - Spring Boot 自动配置
  - 模块启动入口（可选，一般由 Host 组装）
  
  架构说明：
  - 依赖 booking-core 获取业务逻辑
  - 提供 REST API 暴露给 Gateway
  - 自动配置类用于 Host 组装时自动扫描
  
  版本: 3.2.0-SNAPSHOT
  日期: 2026-01-28
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-booking</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>booking-server</artifactId>
    <packaging>jar</packaging>

    <name>Booking Server</name>
    <description>预约模块服务层 - REST Controller、自动配置</description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ========== 模块内部依赖 ========== -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>booking-core</artifactId>
        </dependency>

        <!-- ========== Spring Web ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========== 参数校验 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========== 自动配置 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        
        <!-- ========== OpenAPI 文档（Phase 5: OpenAPI 驱动的前后端契约自动化）========== -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- ========== 工具类 ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== 测试依赖 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ========== Pact Provider 验证（Phase 5.3-2）========== -->
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5</artifactId>
            <version>${pact.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
