<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  app-booking - commercial plugin template
  
  Responsibility: provide a Runtime Shell 3.0.10 commercial plugin template
  that can be declared, assembled, discovered, and started by a Host.
  
  架构约束：
  - 仅依赖 runtime-sdk-api 能力契约
  - 不直接依赖 Kafka/Redis 等基础设施
  - Uses BrixPlugin + PluginContext + ServiceLoader + Manifest
  
  版本: 3.2.0-SNAPSHOT
  日期: 2026-01-28
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>brix-enterprise-solutions-parent</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app-booking</artifactId>
    <packaging>pom</packaging>

    <name>Brix Enterprise App - Booking</name>
    <description>
        Commercial booking plugin template
        
        子模块：
        - booking-api: public template DTOs
        - booking-core: template application service
        - booking-server: Runtime Shell plugin provider and manifest bindings
        
        Phase 5 intentionally exposes no booking business workflow, tables,
        repositories, or integration events.
    </description>

    <!-- ==================== 子模块 ==================== -->
    <modules>
        <module>booking-api</module>
        <module>booking-core</module>
        <module>booking-server</module>
    </modules>

    <!-- ==================== 模块级属性 ==================== -->
    <properties>
        <!-- 端口规划：预约模块暂无独立后端端口，由服务层组装 -->
        <!-- Web 前端开发端口：3015 -->
        <!-- Mobile 前端开发端口：4015 -->
    </properties>

    <!-- ==================== 模块级依赖管理 ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- 模块内部依赖 -->
            <dependency>
                <groupId>io.brix.enterprise.solutions</groupId>
                <artifactId>booking-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.brix.enterprise.solutions</groupId>
                <artifactId>booking-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
