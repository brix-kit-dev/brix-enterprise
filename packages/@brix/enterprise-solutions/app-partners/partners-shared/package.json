{
    "name":  "@brix-sdk/enterprise-partners-shared",
    "version": "3.2.0",
    "private":  true,
    "description":  "合作伙伴模块多端共享类型与常�?- v3.0 Manifest-Driven 架构",
    "main":  "dist/index.js",
    "module":  "dist/index.mjs",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js"
                          },
                    "./types":  {
                                    "types":  "./dist/types/index.d.ts",
                                    "import":  "./dist/types/index.mjs",
                                    "require":  "./dist/types/index.js"
                                },
                    "./events":  {
                                     "types":  "./dist/events/index.d.ts",
                                     "import":  "./dist/events/index.mjs",
                                     "require":  "./dist/events/index.js"
                                 },
                    "./constants":  {
                                        "types":  "./dist/constants/index.d.ts",
                                        "import":  "./dist/constants/index.mjs",
                                        "require":  "./dist/constants/index.js"
                                    },
                    "./generated":  {
                                        "types":  "./dist/generated/index.d.ts",
                                        "import":  "./dist/generated/index.mjs",
                                        "require":  "./dist/generated/index.js"
                                    }
                },
    "files":  [
                  "dist",
                  "README.md"
              ],
    "scripts":  {
                    "generate:api":  "orval --config orval.config.ts",
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "lint":  "eslint src --ext .ts",
                    "typecheck":  "tsc --noEmit",
                    "clean":  "rimraf dist src/generated"
                },
    "dependencies":  {
                         "@brix-sdk/runtime-sdk-api-web":  "^3.1.0"
                     },
    "peerDependencies":  {
                             "@tanstack/react-query":  "^5.0.0"
                         },
    "devDependencies":  {
                            "orval":  "^7.9.0",
                            "prettier":  "^3.8.3",
                            "tsup":  "^8.0.1",
                            "typescript":  "^5.7.2",
                            "rimraf":  "^5.0.5"
                        }
}
