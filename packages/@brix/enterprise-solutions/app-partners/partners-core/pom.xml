<?xml version="1.0" encoding="UTF-8"?>
<!--
    partners-core - partners module core layer
  
    Responsibilities:
    - Domain entities
    - Repository interfaces
    - Business services using RuntimeContext capabilities
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-partners</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>partners-core</artifactId>
    <packaging>jar</packaging>

    <name>Partners Module - Core</name>
    <description>合作伙伴管理核心实现</description>

    <dependencies>
        <!-- 本模块 API -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>partners-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime SDK API - 运行时契约 -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- JPA persistence contract allowed by v3.0.9 R1.1 (not an infra adapter). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
