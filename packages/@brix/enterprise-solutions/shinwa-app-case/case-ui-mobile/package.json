{
  "name": "@shinwa/case-ui-mobile",
  "version": "3.0.0-SNAPSHOT",
  "private": true,
  "description": "Case 模块 Mobile UI — React Native 移动端界面",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "import": "./dist/pages/*.mjs",
      "require": "./dist/pages/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-native": "^0.74.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^9.0.0",
    "@brix/eslint-config-architecture": "workspace:*",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@brix/runtime-sdk-api-mobile": "^3.0.0",
    "@shinwa/case-shared": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.shinwa.io/"
  },
  "author": "Shinwa Team",
  "license": "UNLICENSED"
}
