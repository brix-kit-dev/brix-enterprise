<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  case-app - Standalone Application
  
  Application entry point module providing:
  - Spring Boot Application class
  - Standalone startup capability
  - Integration with host shell or independent operation
  
  Design Notes:
  Following v3.0.4 blueprint:
  - This module serves as the deployment artifact
  - Includes all runtime dependencies
  - Can run standalone or be embedded in host shell
  
  @author Shinwa Team
  @date 2026-02-23
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.app</groupId>
        <artifactId>shinwa-app-case</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>case-app</artifactId>
    <packaging>jar</packaging>
    <name>Case Module - Application</name>
    <description>Standalone application entry point for Case module</description>

    <dependencies>
        <!-- Module dependencies -->
        <dependency>
            <groupId>com.shinwa.app</groupId>
            <artifactId>case-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shinwa.app</groupId>
            <artifactId>case-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.shinwa.app</groupId>
            <artifactId>case-server</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Runtime SDK Integration -->
        <dependency>
            <groupId>io.runtime</groupId>
            <artifactId>runtime-sdk</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.shinwa.app.casemanagement.app.CaseApplication</mainClass>
                    <layout>JAR</layout>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
