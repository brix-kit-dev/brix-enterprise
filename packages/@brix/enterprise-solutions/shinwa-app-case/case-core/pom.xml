<?xml version="1.0" encoding="UTF-8"?>
<!--
  shinwa-app-case-core 模块
  
  Core 模块包含：
  - Entity（实体）
  - Repository（仓储）
  - Service（服务）
  - Handler（事件处理器）
  - Controller（REST 控制器）
  
  【v3.0 核心约束】
  ★ 仅通过 RuntimeContext 访问能力，禁止直接依赖 Kafka/Redis 等基础设施
  ★ 所有跨模块通信通过 EventBusCapability 完成
  ★ 配置通过 ConfigStoreCapability 获取
  
  @author Shinwa Team
  @date 2026-02-23
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.app</groupId>
        <artifactId>shinwa-app-case</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>case-core</artifactId>
    <packaging>jar</packaging>

    <name>Case 模块 - Core</name>
    <description>Case 模块 业务逻辑模块</description>

    <dependencies>
        <!-- ===== 内部依赖 ===== -->
        <!-- API 模块（DTO、Event） -->
        <dependency>
            <groupId>com.shinwa.app</groupId>
            <artifactId>case-api</artifactId>
        </dependency>

        <!-- ===== v3.0 Runtime SDK ===== -->
        <!--
            【Architecture Red Line】Plugin core module MUST only depend on runtime-sdk-api
            - runtime-sdk-api: Contract interfaces (Capabilities, Events, RuntimeContext)
            - runtime-sdk: Implementation classes (PROHIBITED for plugin core)
            
            This constraint ensures:
            1. Plugin decoupled from infrastructure implementation
            2. Testability through mock/stub implementations
            3. Clean dependency graph without transitive infrastructure deps
            
            @see v3.0 Architecture Blueprint §2.2 Layer Dependency Rules
        -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>
        
        <!-- Spring Data JPA（数据持久化） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Validation（参数校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== 工具类 ===== -->
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- MapStruct（对象映射） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.5.5.Final</version>
        </dependency>

        <!-- ===== 测试依赖 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== 架构守护（ArchUnit 红线约束）===== -->
        <!--
            【自动生成】由 create-brix 脚手架内置
            配合 ArchitectureTest.java 自动启用全部 8 条架构红线
        -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <version>3.1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.5.5.Final</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
