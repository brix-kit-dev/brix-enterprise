<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  compliance-server — Compliance Module Server Layer
  
  Responsibilities:
  - REST controllers (ScriptTemplate, ForbiddenWord, ComplianceCheck)
  - Spring Boot AutoConfiguration for the compliance plugin
  - META-INF/plugin-manifest.json for Runtime Shell registration
  
  Architecture constraints:
  - Depends on compliance-core for service implementations
  - Depends on spring-boot-starter-web for REST endpoints
  - This is the deployable unit assembled by the Host
  - [FORBIDDEN] No direct infrastructure imports
  
  @version 3.2.0-SNAPSHOT
  @since 3.2.0
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-compliance</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>compliance-server</artifactId>
    <packaging>jar</packaging>

    <name>Compliance Server</name>
    <description>Compliance module server layer — REST controllers, auto-configuration, plugin manifest</description>

    <dependencies>
        <!-- Intra-module: compliance-core -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>compliance-core</artifactId>
        </dependency>

        <!-- Spring Web (REST endpoints) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Bean Validation (request validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Runtime SDK (capability contracts) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- ========== Test Dependencies ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
