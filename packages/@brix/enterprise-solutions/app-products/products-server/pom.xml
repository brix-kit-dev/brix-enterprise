<?xml version="1.0" encoding="UTF-8"?>
<!--
  ========================================================================
  Products Module - Server
  ========================================================================
  
  产品套餐模块服务器层，包含：
  - REST Controller（ProductController）
  - Spring Boot 自动配置
  - 应用配置文件
  
  v3.0 设计：
  - 作为独立微服务运行（端口 8085）
  - 也可嵌入 host-embedded 统一部署
  
  @author Brix Platform Team
  @since 3.0.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-products</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>products-server</artifactId>
    <packaging>jar</packaging>

    <name>Products Server</name>
    <description>产品套餐模块 - 服务器层（控制器、自动配置）</description>

    <dependencies>
        <!-- 本模块 Core -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>products-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            [D-11 修复] 已移除 spring-boot-starter-actuator。
            蓝图要求：监控/健康检查是 Host 层（Layer 3）的职责，
            插件层（Layer 1）不应包含 Actuator 依赖。
            插件通过 LifecycleCapability.healthCheck() 提供健康状态。
        -->

        <!-- OpenAPI Swagger Annotations -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
    </dependencies>

</project>
