<?xml version="1.0" encoding="UTF-8"?>
<!--
  Partners Core 模块
  
  包含合作伙伴管理的核心实现：
  - Entity：JPA 实体定义
  - Repository：数据仓储
  - ServiceImpl：服务实现（依赖 RuntimeContext）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.solutions</groupId>
        <artifactId>shinwa-app-partners</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>partners-core</artifactId>
    <packaging>jar</packaging>

    <name>Partners Module - Core</name>
    <description>合作伙伴管理核心实现</description>

    <dependencies>
        <!-- 本模块 API -->
        <dependency>
            <groupId>com.shinwa.solutions</groupId>
            <artifactId>partners-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime SDK API - 运行时契约 -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
