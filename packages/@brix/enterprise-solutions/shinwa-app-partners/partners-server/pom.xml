<?xml version="1.0" encoding="UTF-8"?>
<!--
  Partners Server 模块
  
  HTTP 控制器和 Spring Boot 自动配置
  端口：8084
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.solutions</groupId>
        <artifactId>shinwa-app-partners</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>partners-server</artifactId>
    <packaging>jar</packaging>

    <name>Partners Server</name>
    <description>合作伙伴管理服务 HTTP 层</description>

    <dependencies>
        <!-- 本模块 Core -->
        <dependency>
            <groupId>com.shinwa.solutions</groupId>
            <artifactId>partners-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime SDK API -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- [RED-LINE R1 修复] 已移除 postgresql 直接依赖。
             数据库驱动由 infra-adapter-database 适配器在 Host 组装层提供。-->

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OpenAPI Swagger Annotations -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
    </dependencies>

</project>
