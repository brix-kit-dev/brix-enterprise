<?xml version="1.0" encoding="UTF-8"?>
<!--
  消息通知模块 - Server 层
  
  v3.0 Runtime Shell 架构
  REST API 控制器和自动配置
  
  @author Shinwa Team
  @since 3.0.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.solutions</groupId>
        <artifactId>shinwa-app-messenger</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <groupId>com.shinwa.solutions</groupId>
    <artifactId>messenger-server</artifactId>
    <packaging>jar</packaging>
    <name>Messenger Module - Server</name>
    <description>消息通知模块 Server 层 - REST API 和自动配置</description>

    <dependencies>
        <!-- 模块 Core -->
        <dependency>
            <groupId>com.shinwa.solutions</groupId>
            <artifactId>messenger-core</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot Autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OpenAPI Swagger Annotations -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
