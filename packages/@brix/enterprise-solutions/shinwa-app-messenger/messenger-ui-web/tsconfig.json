{
  /**
   * messenger-ui-web TypeScript 配置
   *
   * 说明：
   * 1. paths 配置指向 runtime-sdk 源文件，用于开发时的类型检查
   * 2. 生产构建时，这些依赖由 Host 通过 Module Federation 共享提供
   * 3. noUnusedLocals/noUnusedParameters 设为 false，避免检查外部引用源文件中的未使用变量
   */
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    /* 关闭未使用变量检查，因为 paths 引用的外部源文件可能有未使用的类型导入 */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      /* 本地源文件别名 */
      "@/*": ["src/*"],
      /* @brix 包指向源文件，用于开发时类型检查（生产时由 Host 共享） */
      "@brix/runtime-sdk-api-web": ["../../../runtime-sdk/runtime-sdk-api-web/src/index.ts"],
      "@brix/runtime-sdk-api-web/*": ["../../../runtime-sdk/runtime-sdk-api-web/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
