<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  tenant-core - tenant module core layer

  Responsibilities:
  - Domain entities
  - Repository interfaces
  - Business services
  - ArchUnit architecture guard tests

  Architecture constraints:
  - Depend on runtime-sdk-api for capability contracts
  - Use PluginContext for manifest-declared capabilities
  - Direct Kafka, Redis, MinIO, HTTP client, and non-JPA data-store dependencies are forbidden

  版本: 3.2.0-SNAPSHOT
  日期: 2026-06-10
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-tenant</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tenant-core</artifactId>
    <packaging>jar</packaging>

    <name>Tenant Core</name>
    <description>多租户模块核心层 - 领域模型、业务逻辑、架构守护</description>

    <dependencies>
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>tenant-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4: @DataJpaTest lives in spring-boot-data-jpa-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
