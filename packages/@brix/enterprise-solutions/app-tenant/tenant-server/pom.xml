<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  tenant-server - Tenant Module Server Layer

  Responsibilities:
  - BrixPlugin ServiceLoader entry point
  - REST Controller (API endpoints)
  - Spring Boot Auto-Configuration
  - Module assembly entry point (assembled by Host)

  Architecture:
  - Depends on tenant-core for business logic
  - Depends on tenant-api for DTOs and service interfaces
  - Provides REST API exposed via Gateway
  - Auto-configuration class for Host assembly REST adapter registration

  Version: 3.2.0-SNAPSHOT
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-tenant</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tenant-server</artifactId>
    <packaging>jar</packaging>

    <name>Tenant Server</name>
    <description>Tenant module server layer - BrixPlugin entrypoint, REST Controller, auto-configuration</description>

    <dependencies>
        <!-- Module internal dependencies -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>tenant-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>tenant-core</artifactId>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Auto-Configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- OpenAPI Annotations -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
