{
  "name": "tenant",
  "pluginId": "brix-app-tenant",
  "version": "3.0.0-SNAPSHOT",
  "displayName": "Tenant Management",
  "description": "Brix Enterprise Tenant Management �?provides tenant creation, configuration, lifecycle management, quota control, and multi-tenant isolation for the platform.",

  "ui": {
    "web": {
      "enabled": true,
      "manifestUrl": "/plugins/tenant/ui-manifest.json",
      "scope": "tenant",
      "routes": [
        {
          "path": "/admin/tenants",
          "component": "./pages/TenantList",
          "exact": true,
          "menu": {
            "title": "Tenant List",
            "icon": "business",
            "order": 1,
            "parentId": "platform-admin"
          }
        },
        {
          "path": "/admin/tenants/create",
          "component": "./pages/TenantCreate",
          "menu": {
            "title": "Create Tenant",
            "icon": "add_business",
            "order": 2,
            "parentId": "platform-admin"
          }
        },
        {
          "path": "/admin/tenants/:tenantId",
          "component": "./pages/TenantDetail",
          "menu": {
            "hidden": true
          }
        },
        {
          "path": "/admin/tenants/:tenantId/members",
          "component": "./pages/TenantMembers",
          "menu": {
            "hidden": true
          }
        }
      ],
      "menus": [
        {
          "id": "platform-admin",
          "title": "Platform Admin",
          "icon": "admin_panel_settings",
          "order": 900
        }
      ]
    },
    "mobile": {
      "enabled": false
    }
  },

  "capabilities": {
    "required": ["EventBusCapability", "StateStoreCapability", "AuthCapability", "HttpCapability"],
    "optional": ["NotificationService", "AuditLog"]
  },

  "events": {
    "publish": [
      "TenantCreated",
      "TenantUpdated",
      "TenantSuspended",
      "TenantTerminated"
    ],
    "subscribe": []
  },

  "metadata": {
    "category": "platform",
    "vendor": "Brix Platform",
    "license": "Commercial",
    "minRuntimeVersion": "3.0.0"
  }
}
