<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  app-tenant - 多租户管理模块

  职责：租户生命周期管理、租户隔离与上下文切换

  架构约束：
  - 仅依赖 runtime-sdk-api 能力契约
  - 不直接依赖 Kafka/Redis 等基础设施
  - 通过 PluginContext 获取 Manifest 声明的能力

  版本: 3.2.0-SNAPSHOT
  日期: 2026-06-10
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>brix-enterprise-solutions-parent</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app-tenant</artifactId>
    <packaging>pom</packaging>

    <name>Brix Enterprise App - Tenant</name>
    <description>
        Multi-tenant management business module

        Sub-modules:
        - tenant-api: API layer (DTOs, events, request objects, service interfaces)
        - tenant-core: Core layer (domain model, business logic, ArchUnit guard)
        - tenant-server: Server layer (BrixPlugin entrypoint, Spring Boot auto-configuration, controllers)
    </description>

    <!-- ==================== Sub-modules ==================== -->
    <modules>
        <module>tenant-api</module>
        <module>tenant-core</module>
        <module>tenant-server</module>
    </modules>

    <!-- ==================== Module-level Dependency Management ==================== -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.brix.enterprise.solutions</groupId>
                <artifactId>tenant-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.brix.enterprise.solutions</groupId>
                <artifactId>tenant-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
