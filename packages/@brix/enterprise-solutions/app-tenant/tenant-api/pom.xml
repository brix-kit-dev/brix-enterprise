<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  tenant-api - Tenant Module API Layer

  Responsibilities:
  - DTOs (Data Transfer Objects)
  - Request/Response objects
  - Integration event definitions
  - Service interface declarations

  Design Principles:
  - Pure API definitions, consumed by other modules
  - Only depends on runtime-sdk-api (for event base classes)
  - Contains no business implementation logic

  Version: 3.2.0-SNAPSHOT
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-tenant</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tenant-api</artifactId>
    <packaging>jar</packaging>

    <name>Tenant API</name>
    <description>Tenant module API layer - DTOs, events, request objects, service interfaces</description>

    <dependencies>
        <!-- Runtime SDK API for IntegrationEvent base class -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Jakarta Validation API for constraint annotations -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Jackson Annotations for JSON serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- OpenAPI Schema annotations -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
    </dependencies>
</project>
