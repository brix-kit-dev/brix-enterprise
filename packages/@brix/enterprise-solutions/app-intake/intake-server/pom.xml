<?xml version="1.0" encoding="UTF-8"?>
<!--
  intake-server Module
  
  REST Controller Module containing:
  - REST API endpoints
  - Request/Response handling
  - OpenAPI documentation
  
  【v3.0 Architecture Constraints】
  - Server module only contains controllers (REST endpoints)
  - No business logic — delegates to core layer
  - Full frontend-backend separation per v3.0.4
  
  @author Brix Team
  @date 2026-02-24
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.app</groupId>
        <artifactId>app-intake</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>intake-server</artifactId>
    <packaging>jar</packaging>

    <name>Intake Module - Server</name>
    <description>Intake Module REST Controllers</description>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>io.brix.enterprise.app</groupId>
            <artifactId>intake-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix.enterprise.app</groupId>
            <artifactId>intake-core</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
