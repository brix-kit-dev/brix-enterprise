{
    "name": "@brix-sdk/enterprise-intake-shared",
    "version": "3.2.0",
    "private": true,
    "description": "Intake 模块 多端共享类型与常量 — v3.0 Manifest-Driven 架构",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.mjs",
            "require": "./dist/types/index.js"
        },
        "./events": {
            "types": "./dist/events/index.d.ts",
            "import": "./dist/events/index.mjs",
            "require": "./dist/events/index.js"
        },
        "./constants": {
            "types": "./dist/constants/index.d.ts",
            "import": "./dist/constants/index.mjs",
            "require": "./dist/constants/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "clean": "rimraf dist"
    },
    "dependencies": {},
    "devDependencies": {
        "@brix-sdk/eslint-config-architecture": "link:../../../../../../brix/packages/@brix/platform-devtools/eslint-config-architecture",
        "@types/node": "^20.12.0",
        "eslint": "^9.0.0",
        "prettier": "^3.2.0",
        "rimraf": "^5.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.5.0",
        "vitest": "^2.0.0"
    },
    "peerDependencies": {
        "@brix-sdk/runtime-sdk-api-web": "^3.0.0"
    },
    "publishConfig": {
        "registry": "https://npm.brix.io/"
    },
    "author": "Brix Team",
    "license": "UNLICENSED"
}
