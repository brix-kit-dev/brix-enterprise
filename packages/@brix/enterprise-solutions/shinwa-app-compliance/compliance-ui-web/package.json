{
  "name": "@shinwa/compliance-ui-web",
  "version": "1.0.0-SNAPSHOT",
  "private": true,
  "description": "Compliance management UI module for script templates and forbidden words detection",
  "type": "module",
  "scripts": {
    "dev": "rspack serve --mode=development",
    "build": "rspack build --mode=production",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shinwa/compliance-shared": "workspace:*",
    "@brix/runtime-sdk-react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@brix/eslint-config-architecture": "^3.1.0",
    "@rspack/cli": "^1.1.0",
    "@rspack/core": "^1.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.0.0",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pages": "./src/pages/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts"
