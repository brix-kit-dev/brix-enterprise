{
  /**
   * messenger-ui-web TypeScript Configuration
   *
   * Notes:
   * 1. paths map local aliases for development-time type checking
   * 2. @brix-sdk/* packages are resolved via pnpm link: in package.json (node_modules)
   * 3. Production builds share these dependencies through Module Federation (Host-provided)
   * 4. noUnusedLocals/noUnusedParameters disabled to avoid false positives from linked source files
   */
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    /* Disabled: linked source files may contain unused imports that trigger false positives */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      /* Local source alias */
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
