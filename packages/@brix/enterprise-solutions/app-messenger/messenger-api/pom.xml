<?xml version="1.0" encoding="UTF-8"?>
<!--
  消息通知模块 - API 层
  
  v3.0 Runtime Shell 架构
  定义对外暴露的 DTO、事件、服务接口
  
  @author Brix Team
  @since 3.0.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-messenger</artifactId>
        <version>3.2.0-SNAPSHOT</version>
    </parent>

    <groupId>io.brix.enterprise.solutions</groupId>
    <artifactId>messenger-api</artifactId>
    <packaging>jar</packaging>
    <name>Messenger Module - API</name>
    <description>消息通知模块 API 层 - DTO、事件、服务接口定义</description>

    <dependencies>
        <!-- Runtime SDK API - 仅依赖接口层 -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!--
            [D-8 修复] 已移除 spring-data-commons 依赖。
            API 层应保持框架无关（蓝图 §4 Plugin 模型规范）。
            分页使用自定义 PagedRequest/PagedResponse 替代 Spring Data 的 Page/Pageable。
        -->

        <!-- Jakarta Validation -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OpenAPI Swagger Annotations -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
    </dependencies>

</project>
