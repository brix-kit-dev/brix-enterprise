<?xml version="1.0" encoding="UTF-8"?>
<!--
  消息通知模块 - Core 层
  
  v3.0 Runtime Shell 架构
  包含实体、仓储、服务实现
  
  @author Brix Team
  @since 3.0.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-messenger</artifactId>
        <version>3.2.0-SNAPSHOT</version>
    </parent>

    <groupId>io.brix.enterprise.solutions</groupId>
    <artifactId>messenger-core</artifactId>
    <packaging>jar</packaging>
    <name>Messenger Module - Core</name>
    <description>消息通知模块 Core 层 - 实体、仓储、服务实现</description>

    <dependencies>
        <!-- 模块 API -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>messenger-api</artifactId>
        </dependency>

        <!-- Runtime SDK API - 能力契约 -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Spring Boot Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JPA persistence contract allowed by v3.0.9 R1.1 (not an infra adapter). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Jakarta Persistence -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
