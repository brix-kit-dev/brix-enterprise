{
  "name": "@shinwa/booking-shared",
  "version": "3.0.0-SNAPSHOT",
  "private": true,
  "description": "预约模块多端共享类型与常�?- v3.0 Manifest-Driven 架构",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "require": "./dist/events/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    },
    "./generated": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.mjs",
      "require": "./dist/generated/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "test:pact:publish": "pact-broker publish pacts --consumer-app-version $(git rev-parse --short HEAD) --broker-base-url ${PACT_BROKER_URL:-http://localhost:9292}",
    "clean": "rimraf dist src/generated pacts"
  },
  "dependencies": {
    "@brix/runtime-sdk-api-web": "link:../../../../runtime-sdk/runtime-sdk-api-web"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.2.0",
    "orval": "^7.9.0",
    "prettier": "^3.4.2",
    "tsup": "^8.0.1",
    "typescript": "^5.7.2",
    "rimraf": "^5.0.5",
    "vitest": "^3.0.0"
  }
}
