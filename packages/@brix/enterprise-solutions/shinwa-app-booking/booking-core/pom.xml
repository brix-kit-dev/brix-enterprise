<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  booking-core - 预约模块核心层
  
  职责：
  - 领域模型（Entity）
  - 仓库接口（Repository）
  - 业务逻辑服务（Service）
  - 事件处理器（EventHandler）
  
  架构约束：
  - 依赖 booking-api 获取 DTO 和事件定义
  - 依赖 runtime-sdk-api 获取能力契约
  - 通过 RuntimeContext 使用能力（EventBus、StateStore 等）
  - 保留 spring-data-jpa 用于数据持久化
  - 【禁止】直接依赖 spring-kafka、spring-data-redis
  
  版本: 3.0.0-SNAPSHOT
  日期: 2026-01-28
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.solutions</groupId>
        <artifactId>shinwa-app-booking</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>booking-core</artifactId>
    <packaging>jar</packaging>

    <name>Booking Core</name>
    <description>预约模块核心层 - 领域模型、业务逻辑、事件处理器</description>

    <dependencies>
        <!-- ========== 模块内部依赖 ========== -->
        <dependency>
            <groupId>com.shinwa.solutions</groupId>
            <artifactId>booking-api</artifactId>
        </dependency>

        <!-- ========== 跨模块事件契约依赖 ========== -->
        <!--
            【设计说明】
            依赖 identity-api 用于订阅 UserDisabledEvent 等集成事件。
            仅依赖 API 层（事件定义），不依赖 core 实现。
        -->
        <dependency>
            <groupId>com.shinwa.solutions</groupId>
            <artifactId>identity-api</artifactId>
        </dependency>

        <!-- ========== Runtime SDK（开源核心层）========== -->
        <!--
            【核心依赖】运行壳能力契约
            通过 RuntimeContext 获取：
            - EventBusCapability: 事件发布
            - StateStoreCapability: 状态存储
            - AuthContextCapability: 认证上下文
            - ObservabilityCapability: 日志/指标/追踪
        -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- ========== 持久层（JPA 允许保留）========== -->
        <!--
            【设计说明】
            JPA 属于持久化能力的标准接口，不属于基础设施耦合。
            具体的数据源配置由 Host 层提供。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========== 工具类 ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== 测试依赖 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
