{
  "name": "@shinwa/booking-app",
  "version": "3.0.0-SNAPSHOT",
  "private": true,
  "description": "预约应用 - v3.0 Manifest-Driven 架构",
  "scripts": {
    "generate:api": "pnpm --filter @shinwa/booking-shared generate:api",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @shinwa/booking-shared build",
    "build:web": "pnpm --filter @shinwa/booking-web build",
    "dev:web": "pnpm --filter @shinwa/booking-web start",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  }
}
