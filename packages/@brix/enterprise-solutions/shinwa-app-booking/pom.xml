<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  shinwa-app-booking - 预约管理模块（P0 试点）
  
  职责：提供资源预约的完整业务能力
  - 可预约资源管理
  - 时间槽配置与查询
  - 预约创建/确认/取消/完成
  - 预约日历展示
  
  架构约束：
  - 仅依赖 runtime-sdk-api 能力契约
  - 不直接依赖 Kafka/Redis 等基础设施
  - 通过 RuntimeContext 获取所有能力
  
  版本: 3.0.0-SNAPSHOT
  日期: 2026-01-28
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.solutions</groupId>
        <artifactId>shinwa-solutions-parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shinwa-app-booking</artifactId>
    <packaging>pom</packaging>

    <name>Shinwa App - Booking</name>
    <description>
        预约管理业务模块
        
        子模块：
        - booking-api: API 层（DTO、Request、Response、事件定义）
        - booking-core: Core 层（领域模型、业务逻辑、仓库接口）
        - booking-server: Server 层（Spring Boot 自动配置、控制器）
        
        本模块是 v3.0 架构改造的 P0 试点模块，演示：
        1. 模块仅依赖 runtime-sdk-api
        2. 通过 RuntimeContext 获取能力
        3. 事件驱动的模块间通信
    </description>

    <!-- ==================== 子模块 ==================== -->
    <modules>
        <module>booking-api</module>
        <module>booking-core</module>
        <module>booking-server</module>
    </modules>

    <!-- ==================== 模块级属性 ==================== -->
    <properties>
        <!-- 端口规划：预约模块暂无独立后端端口，由服务层组装 -->
        <!-- Web 前端开发端口：3015 -->
        <!-- Mobile 前端开发端口：4015 -->
    </properties>

    <!-- ==================== 模块级依赖管理 ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- 模块内部依赖 -->
            <dependency>
                <groupId>com.shinwa.solutions</groupId>
                <artifactId>booking-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shinwa.solutions</groupId>
                <artifactId>booking-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
