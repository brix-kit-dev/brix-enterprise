<?xml version="1.0" encoding="UTF-8"?>
<!--
  v3.0 业务应用模块父 POM
  
  模块结构：
  - case-api:  API 模块（DTO、Event、Request）
  - case-core: 业务逻辑模块
  - case-ui:   前端界面模块（NPM 包）
  - case-app:  可独立运行的启动模块
  
  遵循 v3.0 运行壳架构设计蓝图：
  - 仅依赖 io.runtime:runtime-sdk（能力契约）
  - 不直接依赖 Kafka/Redis/HTTP 等基础设施
  
  @author Brix Team
  @date 2026-02-23
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent POM: Inherit from enterprise-solutions-parent for unified management -->
    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>brix-enterprise-solutions-parent</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.brix.enterprise.solutions</groupId>
    <artifactId>app-case</artifactId>
    <version>3.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Case 模块</name>
    <description>Brix Platform v3.0 业务应用模块</description>

    <!-- 子模块 -->
    <modules>
        <module>case-api</module>
        <module>case-core</module>
        <module>case-server</module>
        <module>case-app</module>
    </modules>

    <properties>
        <!-- Version management — spring-boot.version inherited from parent (3.2.2) -->
        <!--
          Brix Runtime SDK version. Aligned with the published io.brix:runtime-sdk-* artifacts
          (groupId migrated from legacy io.runtime → io.brix in v3.1.0).
        -->
        <runtime-sdk.version>3.2.0</runtime-sdk.version>
        
        <!-- 编译配置 -->
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 依赖管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- v3.1 Runtime SDK contract layer (capability + event contracts) -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>runtime-sdk-api</artifactId>
                <version>${runtime-sdk.version}</version>
            </dependency>
            <!-- v3.1 Runtime Orchestrator (lifecycle, registry, event dispatcher, manifest loader) -->
            <dependency>
                <groupId>io.brix</groupId>
                <artifactId>runtime-orchestrator</artifactId>
                <version>${runtime-sdk.version}</version>
            </dependency>
            
            <!-- 内部模块 -->
            <dependency>
                <groupId>io.brix.enterprise.solutions</groupId>
                <artifactId>case-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.brix.enterprise.solutions</groupId>
                <artifactId>case-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
