<?xml version="1.0" encoding="UTF-8"?>
<!--
  app-case-api 模块
  
  API 模块包含：
  - DTO（数据传输对象）
  - Event（领域事件定义）
  - Request（请求对象）
  
  【v3.0 架构约束】
  - 此模块仅包含类型定义，不包含业务逻辑
  - 供其他模块依赖，用于模块间通信
  
  @author Brix Team
  @date 2026-02-23
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.enterprise.solutions</groupId>
        <artifactId>app-case</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>case-api</artifactId>
    <packaging>jar</packaging>

    <name>Case 模块 - API</name>
    <description>Case 模块 API 模块（DTO、Event、Request）</description>

    <dependencies>
        <!-- v3.1 Runtime SDK API (event base classes, schema-version annotation) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- Lombok（可选，简化代码） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- Jakarta Validation（DTO 校验） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>
</project>
