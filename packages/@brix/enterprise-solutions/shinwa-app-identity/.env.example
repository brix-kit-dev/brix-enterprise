# ============================================================
# Identity Module - 环境变量配置模板
# ============================================================
#
# 使用说明：
#   1. 复制本文件为 .env
#   2. 修改下方配置值
#   3. .env 文件已在 .gitignore 中，不会提交到版本控制
#
# ⚠️ 安全警告：
#   - 请勿将真实密码提交到版本控制系统
#   - 生产环境请使用 Secrets Manager 或 Vault
#
# ============================================================

# ==================== PostgreSQL ====================
POSTGRES_USER=brix
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=brix_platform

# ==================== 数据库连接 (应用使用) ====================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=brix
DB_PASSWORD=your-secure-password-here
DB_NAME=brix_platform

# ==================== JWT ====================
JWT_SECRET=your-jwt-secret-key-here-at-least-32-characters

# ==================== Google OAuth2 (可选) ====================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
