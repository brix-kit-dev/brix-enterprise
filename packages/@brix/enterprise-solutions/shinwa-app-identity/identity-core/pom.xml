<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  identity-core - 用户身份模块核心层
  
  职责：
  - 领域模型（Entity）
  - 仓库接口（Repository）
  - 业务逻辑服务（Service）
  - 事件处理器（EventHandler）
  
  架构约束：
  - 依赖 identity-api 获取 DTO 和事件定义
  - 依赖 runtime-sdk-api 获取能力契约
  - 通过 RuntimeContext 使用能力（EventBus、StateStore 等）
  - 保留 spring-data-jpa 用于数据持久化
  - 【禁止】直接依赖 spring-kafka、spring-data-redis
  
  迁移来源：plugin-user-core
  版本: 3.0.0-SNAPSHOT
  日期: 2026-01-28
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinwa.solutions</groupId>
        <artifactId>shinwa-app-identity</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>identity-core</artifactId>
    <packaging>jar</packaging>

    <name>Identity Core</name>
    <description>用户身份模块核心层 - 领域模型、业务逻辑、事件处理器</description>

    <dependencies>
        <!-- ========== 模块内部依赖 ========== -->
        <dependency>
            <groupId>com.shinwa.solutions</groupId>
            <artifactId>identity-api</artifactId>
        </dependency>

        <!-- ========== Runtime SDK（开源核心层）========== -->
        <!--
            【核心依赖】运行壳能力契约
            通过 RuntimeContext 获取：
            - EventBusCapability: 事件发布
            - StateStoreCapability: 状态存储
            - AuthContextCapability: 认证上下文
            - ObservabilityCapability: 日志/指标/追踪
        -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>

        <!-- ========== 持久层（JPA 允许保留）========== -->
        <!--
            【设计说明】
            JPA 属于持久化能力的标准接口，不属于基础设施耦合。
            具体的数据源配置由 Host 层提供。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========== JSON 处理（OAuth2 需要）========== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ========== 数据库迁移（Flyway）========== -->
        <!--
            【设计说明】
            使用 Flyway 管理 DDL 变更而非 ddl-auto: update。
            迁移脚本位于: src/main/resources/db/migration/
            注意: flyway-database-postgresql 需要 Flyway 10+，
            在 Spring Boot 3.2.x（Flyway 9.x）中 PostgreSQL 支持内置于 flyway-core
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- ========== 工具类 ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== 测试依赖 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
