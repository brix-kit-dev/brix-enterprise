{
  "name": "@shinwa/identity-app",
  "version": "3.0.0-SNAPSHOT",
  "private": true,
  "description": "身份认证应用 - v3.0 Manifest-Driven 架构",
  "scripts": {
    "generate:api": "pnpm --filter @shinwa/identity-shared generate:api",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @shinwa/identity-shared build",
    "build:web": "pnpm --filter @shinwa/identity-web build",
    "dev:web": "pnpm --filter @shinwa/identity-web start",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  }
}
