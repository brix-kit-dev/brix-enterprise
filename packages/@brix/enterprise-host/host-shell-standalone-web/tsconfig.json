{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@brix-sdk/runtime-orchestrator-web": ["../../../../../brix/packages/@brix/runtime-sdk/runtime-orchestrator-web/src/index.ts"],
      "@brix-sdk/runtime-sdk-api-web": ["../../../../../brix/packages/@brix/runtime-sdk/runtime-sdk-api-web/src/index.ts"],
      "@brix-sdk/runtime-sdk-react": ["../../../../../brix/packages/@brix/runtime-sdk/runtime-sdk-react/src/index.ts"],
      "@brix-sdk/platform-admin-web": ["../../../../../brix/packages/@brix/platform-commons/packages/client/platform-admin-web/src/index.ts"],
      "@brix-sdk/shared-runtime-web/react": ["../../../../../brix/packages/@brix/shared-runtime/shared-runtime-web/src/react.ts"],
      "@brix-sdk/shared-runtime-web/router": ["../../../../../brix/packages/@brix/shared-runtime/shared-runtime-web/src/router.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
