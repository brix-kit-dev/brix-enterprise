{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths — resolve link: dependencies for IDE type checking */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@brix-sdk/platform-frame-web": ["../../../../../brix/packages/@brix/platform-commons/packages/client/platform-frame-web/dist/index.d.ts"],
      "@brix-sdk/platform-auth-service-web": ["../../../../../brix/packages/@brix/platform-commons/packages/client/platform-auth-service-web/dist/index.d.ts"],
      "@brix-sdk/platform-auth-web": ["../../platform-commons/packages/client/platform-auth-web/dist/index.d.ts"],
      "@brix-sdk/platform-router-web": ["../../platform-commons/packages/client/platform-router-web/dist/index.d.ts"],
      "@brix-sdk/platform-navigation-web": ["../../platform-commons/packages/client/platform-navigation-web/dist/index.d.ts"],
      "@brix-sdk/platform-eventbus-web": ["../../platform-commons/packages/client/platform-eventbus-web/dist/index.d.ts"],
      "@brix-sdk/runtime-sdk-api-web": ["../../runtime-sdk/runtime-sdk-api-web/dist/index.d.ts"],
      "@brix-sdk/runtime-sdk-react": ["../../runtime-sdk/runtime-sdk-react/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
