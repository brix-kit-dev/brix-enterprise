{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths - 配置 link 依赖的类型解析 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shinwa/shinwa-platform-shell-web": ["../../shinwa-platform/shinwa-platform-shell-web/dist/index.d.ts"],
      "@brix/platform-auth-web": ["../../platform-commons/packages/client/platform-auth-web/dist/index.d.ts"],
      "@brix/platform-router-web": ["../../platform-commons/packages/client/platform-router-web/dist/index.d.ts"],
      "@brix/platform-navigation-web": ["../../platform-commons/packages/client/platform-navigation-web/dist/index.d.ts"],
      "@brix/platform-eventbus-web": ["../../platform-commons/packages/client/platform-eventbus-web/dist/index.d.ts"],
      "@brix/runtime-sdk-api-web": ["../../runtime-sdk/runtime-sdk-api-web/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
