# =============================================================================
# Brix Platform - Host Standalone Web Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
# Google Cloud Console configured client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth callback URL (must match the one configured in Google Cloud Console)
VITE_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback/google

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL (required for production; dev fallback: http://localhost:8080/api)
VITE_API_BASE=/api

# -----------------------------------------------------------------------------
# Plugin Configuration
# -----------------------------------------------------------------------------
# Each plugin registered in localPlugins (host.config.ts) MUST have a
# corresponding VITE_PLUGIN_<NAME>_URL entry. resolvePluginUrl() throws at
# module load time if the URL is missing in production mode.
# Development: http://localhost:<port>
# Production:  https://cdn.example.com/plugins/<name>
VITE_PLUGIN_PRODUCTS_URL=http://localhost:3004
VITE_PLUGIN_PARTNERS_URL=http://localhost:3003
VITE_PLUGIN_TENANT_URL=http://localhost:3054
