<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.host</groupId>
        <artifactId>host-assembly</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>host-contract-tests</artifactId>
    <name>Brix Host - Contract Tests</name>
    <description>
        Contract tests verifying behavioral consistency between Standalone and Embedded host modes.
        Ensures that plugins observe identical EventBus, StateStore, and Auth capability behavior
        regardless of the underlying adapter implementation (Kafka vs Webhook, Redis vs InMemory).

        Architecture Layer: Test-only module (R4.2 compliance)
    </description>

    <dependencies>
        <!-- Runtime SDK API (Capability contracts) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
            <version>${runtime-sdk.version}</version>
        </dependency>

        <!-- Standalone adapters (Kafka, Redis) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-kafka-core</artifactId>
            <version>${infra-adapters.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Embedded adapters (InMemory, Webhook) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-simple</artifactId>
            <version>${infra-adapters.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-webhook</artifactId>
            <version>${infra-adapters.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Test frameworks -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*ContractTest.java</include>
                        <include>**/*CompatibilityTest.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
