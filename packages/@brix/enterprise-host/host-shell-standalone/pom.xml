<?xml version="1.0" encoding="UTF-8"?>
<!--
  =========================================================
  host-shell-standalone - 产品模式运行壳
  
  职责：
  - 组装完整运行时能力（Kafka EventBus, Redis StateStore, OTel）
  - 集成所有业务模块 (app-*)
  - 提供 Spring Boot 可执行入口
  - 支持 Docker 容器化部署
  
  版本: 3.0.4-SNAPSHOT (产品模式完整功能)
  =========================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.brix.host</groupId>
        <artifactId>host-assembly</artifactId>
        <version>3.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>host-shell-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Brix Host Shell - Standalone</name>
    <description>
        产品模式运行壳（Standalone Mode Runtime Shell）
        
        ═══════════════════════════════════════════════════════════════════════
        【定位】完整功能的可运行运行壳，包含能力组装 + 业务模块 + Spring Boot 入口
        ═══════════════════════════════════════════════════════════════════════
        
        提供完整的能力组装：
        - Kafka EventBus（生产级别消息）
        - Redis StateStore（分布式状态）
        - Redis Lock（分布式锁）
        - OpenTelemetry Observability（可观测性）
        - Full Scheduling（定时任务）
        
        适用场景：
        - Brix Platform 标准产品部署
        - 需要完整功能的生产环境
        - 需要所有基础设施能力的场景
        
        启动命令：
        java -jar host-shell-standalone.jar --spring.profiles.active=standalone
        
        Docker 启动：
        docker run -p 8081:8081 brix/host-shell-standalone:3.2.0-SNAPSHOT
    </description>

    <properties>
        <start-class>io.brix.enterprise.host.standalone.ShellApplication</start-class>
    </properties>

    <dependencies>
        <!-- ========== Platform Commons（公共基类）========== -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-common-starter</artifactId>
        </dependency>

        <!-- ========== Runtime SDK API（包含契约接口）========== -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-sdk-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-manifest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>runtime-orchestrator</artifactId>
        </dependency>

        <!-- ========== Infrastructure Adapters - 完整组装 ========== -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-kafka-core</artifactId>
        </dependency>
        <!-- Broker-neutral canonical Outbox persistence used by the Runtime Relay. -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-otel</artifactId>
        </dependency>
        <!--
          Architecture fix: Fallback capability adapter providing default implementations.
                    Declared by dependency so Spring Boot auto-configuration discovery can assemble
                    fallback capabilities without host-side scan rules or marker references.
        -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-fallback</artifactId>
        </dependency>
        <!-- ✅ 红线 R1 修复：数据库能力适配器（PostgreSQL + HikariCP） -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-database</artifactId>
        </dependency>
        <!-- Owner-scoped PersistenceCapability (root blueprint 3.1.0 §7) -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-persistence-jpa</artifactId>
        </dependency>
        <!-- ✅ 红线 R1 修复：文件存储能力适配器（MinIO） -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-minio</artifactId>
        </dependency>
        <!-- SMTP adapter for managed NotificationCapability delivery. -->
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>infra-adapter-email-smtp</artifactId>
        </dependency>

        <!-- ========== Platform Auth Servlet（认证能力 — Servlet 运行时绑定）========== -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-auth-servlet</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- spring-security-crypto: platform-auth 将其声明为 optional，Host 必须显式引入
             以确保 BCryptPasswordEncoder 在 fat JAR 中可用，从而激活 PasswordCapabilityAutoConfiguration
             → PasswordCapability → AuthFlowCapability internal contract 启动成功 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Platform Auth Operational: publishes AuthFlow internal contract through Runtime Shell. -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-auth-operational</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- ========== Platform Tenant（多租户能力）========== -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-tenant</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- Platform Identity: owns bootstrap/global identity internal contracts. -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-identity</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!--
          ========== Platform Notification（平台通知能力 — L2B）==========
          Provides NotificationCapability policy/template orchestration. SMTP is
          selected by the Host profile through infra-adapter-email-smtp.
        -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-notification</artifactId>
        </dependency>

        <!--
          ========== Platform Admin（平台运维控制面 — L2B platform-operational）==========
          Provides /api/platform/** endpoints through Runtime Shell Dispatcher.
          Host assembles this artifact only by dependency declaration and
          brix.runtime-shell.required-operational-modules; no host-side code/wiring.
        -->
        <dependency>
            <groupId>io.brix.platform</groupId>
            <artifactId>platform-admin</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- ========== 业务模块（按需引入）========== -->
        <!-- 用户身份 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>identity-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- ========== 业务模块 - 产品模式完整功能 ========== -->
        <!-- 预约管理 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>booking-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 产品套餐管理 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>products-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 合作伙伴管理 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>partners-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 消息通知 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>messenger-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 轮播Banner管理 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>carousel-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- Case管理 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>case-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 合同管理 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>contracts-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 文件存储 -->
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>storage-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>

        <!-- 进件管理 (待集成：需调整 Maven 构建顺序后启用)
        <dependency>
            <groupId>io.brix.enterprise.solutions</groupId>
            <artifactId>intake-server</artifactId>
            <version>3.2.0-SNAPSHOT</version>
        </dependency>
        -->

        <!-- ========== Spring Boot Starter ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========== 数据库（PostgreSQL）========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== Logging ========== -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ========== Testing ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.brix</groupId>
            <artifactId>architecture-guard</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ci-runtime-shell</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>ci-runtime-shell-3.0.10</id>
            <properties>
                <brix.runtime-shell.model>3.0.10</brix.runtime-shell.model>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <brix.runtime-shell.model>${brix.runtime-shell.model}</brix.runtime-shell.model>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>booking-template</id>
            <dependencies>
                <dependency>
                    <groupId>io.brix.enterprise.solutions</groupId>
                    <artifactId>booking-server</artifactId>
                    <version>3.2.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>openapi-generate</id>
            <properties>
                <openapi.server.port>18081</openapi.server.port>
                <openapi.mfa.encryption-key></openapi.mfa.encryption-key>
                <openapi.minio.access-key></openapi.minio.access-key>
                <openapi.minio.secret-key></openapi.minio.secret-key>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                    <version>2.6.0</version>
                </dependency>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <id>start-for-openapi</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>stop-for-openapi</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>${start-class}</mainClass>
                            <arguments>
                                <argument>--spring.profiles.active=standalone,openapi</argument>
                                <argument>--server.port=${openapi.server.port}</argument>
                                <argument>--spring.datasource.url=jdbc:h2:mem:brix_openapi;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</argument>
                                <argument>--spring.datasource.username=sa</argument>
                                <argument>--spring.datasource.password=</argument>
                                <argument>--spring.datasource.driver-class-name=org.h2.Driver</argument>
                                <argument>--spring.jpa.database-platform=org.hibernate.dialect.H2Dialect</argument>
                                <argument>--spring.jpa.hibernate.ddl-auto=none</argument>
                                <argument>--spring.flyway.enabled=false</argument>
                                <argument>--brix.infra.database.migration.enabled=false</argument>
                                <argument>--brix.infra.minio.access-key=${openapi.minio.access-key}</argument>
                                <argument>--brix.infra.minio.secret-key=${openapi.minio.secret-key}</argument>
                                <argument>--brix.infra.minio.initialize-bucket-on-startup=false</argument>
                                <argument>--brix.platform.admin.setup.logging-notification-enabled=true</argument>
                                <argument>--brix.platform.bootstrap.super-admin.enabled=false</argument>
                                <argument>--brix.platform.mfa.encryption-key=${openapi.mfa.encryption-key}</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>1.4</version>
                        <executions>
                            <execution>
                                <id>generate-openapi</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <apiDocsUrl>http://localhost:${openapi.server.port}/v3/api-docs</apiDocsUrl>
                            <outputDir>${project.build.directory}</outputDir>
                            <outputFileName>openapi.json</outputFileName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
