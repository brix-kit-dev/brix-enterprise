# ============================================================
# Brix Platform - Environment Variables Configuration Template
# ============================================================
# 
# Usage:
#   1. Copy this file to .env
#   2. Fill in actual passwords and configuration values
#   3. Ensure .env file is not committed to version control
#
# Security Warning:
#   - NEVER commit .env file to Git
#   - Use Vault or K8s Secrets for production sensitive data
#
# ============================================================

# ==================== Database Configuration ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brix_platform
DB_USERNAME=brix
# Required: Database password (use strong password in production)
DB_PASSWORD=your_secure_password_here

# ==================== Redis Configuration ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ==================== Kafka Configuration ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==================== Observability Configuration ====================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=host-shell-standalone

# ==================== Grafana Configuration ====================
# Required: Grafana admin password
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ==================== JWT Configuration ====================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# ==================== Google OAuth2 Configuration ====================
# Required for OAuth login functionality.
# Obtain credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 
# IMPORTANT: These values are REQUIRED. The application will fail to start
# without them when OAuth is enabled.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ==================== Token Encryption Key ====================
# Required by app-identity to encrypt OAuth2 tokens at rest (AES-256-GCM).
# The TokenEncryptionConverter SHA-256 hashes this value to derive a 256-bit key,
# so any non-blank secret is accepted; use a 32+ byte random value.
# Generate: openssl rand -base64 32
# IMPORTANT: No default is permitted; the application fails to start without it.
TOKEN_ENCRYPTION_KEY=replace_with_base64_of_32_random_bytes

# ==================== Module Configuration ====================
BRIX_MODULE_ID=brix-platform
BRIX_TENANT_ID=default

# ==================== Platform Admin Setup Email ====================
# Setup links are delivered only through NotificationCapability.
# For local capture without external delivery, start with docker-compose.dev-smtp.yml
# and open Mailpit at http://localhost:8025.
BRIX_PLATFORM_ADMIN_SETUP_BASE_URL=http://localhost:3001/platform/setup
BRIX_PLATFORM_ADMIN_SETUP_MAIL_FROM=platform-admin@brix.local
BRIX_PLATFORM_ADMIN_SETUP_TOKEN_TTL_SECONDS=86400
BRIX_PLATFORM_ADMIN_SETUP_RETURN_URL_FOR_DEV_ONLY=false
# Keep false unless you intentionally want local/dev setup links in server logs.
BRIX_PLATFORM_ADMIN_SETUP_LOGGING_NOTIFICATION_ENABLED=false

# Real SMTP delivery (example keys only; use provider-specific credentials).
# For Gmail, use an app password and STARTTLS on smtp.gmail.com:587.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# ==================== Super Admin Bootstrap ====================
BRIX_BOOTSTRAP_SUPER_ADMIN_ENABLED=true
BRIX_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BRIX_BOOTSTRAP_SUPER_ADMIN_USERNAME=Super Admin
BRIX_BOOTSTRAP_SUPER_ADMIN_SETUP_CODE=replace_with_strong_one_time_setup_code
BRIX_BOOTSTRAP_SUPER_ADMIN_SETUP_CODE_TTL_SECONDS=900
BRIX_BOOTSTRAP_SUPER_ADMIN_SESSION_TTL_SECONDS=300
