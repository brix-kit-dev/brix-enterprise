# ============================================================
# Shinwa Platform - 环境变量配置模板
# ============================================================
# 
# 使用方法：
#   1. 复制此文件为 .env
#   2. 填写实际的密码和配置值
#   3. 确保 .env 文件不会提交到版本控制
#
# ⚠️ 安全警告：
#   - 绝不要将 .env 文件提交到 Git
#   - 生产环境使用 Vault 或 K8s Secrets 管理敏感信息
#
# ============================================================

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shinwa_platform
DB_USERNAME=shinwa
# 🔴 必填：数据库密码（生产环境使用强密码）
DB_PASSWORD=your_secure_password_here

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ==================== Kafka 配置 ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==================== 可观测性配置 ====================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=host-shell-standalone

# ==================== Grafana 配置 ====================
# 🔴 必填：Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# ==================== 模块配置 ====================
BRIX_MODULE_ID=shinwa-platform
BRIX_TENANT_ID=default
