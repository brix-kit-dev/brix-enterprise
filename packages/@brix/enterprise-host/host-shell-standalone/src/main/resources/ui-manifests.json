    "shinwa-app-identity": {
      "plugin": {
        "id": "identity",
        "name": "身份认证",
        "version": "3.0.0"
      },
      "federation": {
        "name": "identity",
        "filename": "remoteEntry.js",
        "exposes": {}
      },
      "pages": [
        {
          "pageId": "identity:user-list",
          "component": "./pages/UserList",
          "title": "用户列表",
          "platforms": { "web": { "suggestedPath": "/identity/users" } }
        },
        {
          "pageId": "identity:user-detail",
          "component": "./pages/UserDetail",
          "title": "用户详情",
          "platforms": { "web": { "suggestedPath": "/identity/users/:id" } }
        },
        {
          "pageId": "identity:user-create",
          "component": "./pages/UserCreate",
          "title": "创建用户",
          "platforms": { "web": { "suggestedPath": "/identity/users/create" } }
        }
      ],
      "menus": [
        {
          "id": "identity",
          "title": "身份认证",
          "order": 10,
          "children": [
            {
              "id": "identity:user-list",
              "title": "用户管理",
              "pageId": "identity:user-list",
              "order": 1
            },
            {
              "id": "identity:user-create",
              "title": "创建用户",
              "pageId": "identity:user-create",
              "order": 2
            }
          ]
        }
      ]
    },
