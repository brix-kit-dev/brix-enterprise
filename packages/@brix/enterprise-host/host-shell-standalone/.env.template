# ============================================================
# Environment Configuration Template
# ============================================================
# COPY this file to .env and fill in your values
# NEVER commit .env to Git!
# ============================================================

# ---------------------- Server Configuration ----------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------------------- Database ----------------------
# 【开发环境】使用本地 PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/shinwa_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# ---------------------- Redis ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------- Kafka ----------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------- MinIO ----------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here

# ---------------------- JWT Configuration ----------------------
# 【安全警告】生产环境必须使用强密钥！
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# ---------------------- OAuth Configuration ----------------------
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback/google

# ---------------------- Observability ----------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=shinwa-host

# ---------------------- Logging ----------------------
LOG_LEVEL=DEBUG
