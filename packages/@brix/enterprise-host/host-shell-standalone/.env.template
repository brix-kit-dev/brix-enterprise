# ============================================================
# Environment Configuration Template
# ============================================================
# COPY this file to .env and fill in your values
# NEVER commit .env to Git!
# ============================================================

# ---------------------- Server Configuration ----------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------------------- Database ----------------------
# Development: local PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/brix_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# ---------------------- Redis ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------- Kafka ----------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------- MinIO ----------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here

# ---------------------- JWT Configuration ----------------------
# SECURITY WARNING: Production MUST use a strong secret key!
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# ---------------------- OAuth Configuration ----------------------
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback/google

# ---------------------- Token Encryption ----------------------
# AES-256-GCM key for app-identity OAuth token persistence (REQUIRED, no default).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_at_least_32_bytes_base64

# ---------------------- Observability ----------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=brix-host

# ---------------------- Logging ----------------------
LOG_LEVEL=DEBUG

# ---------------------- Platform Admin Setup Email ----------------------
# Setup links are delivered through NotificationCapability only.
BRIX_PLATFORM_ADMIN_SETUP_BASE_URL=http://localhost:3001/platform/setup
BRIX_PLATFORM_ADMIN_SETUP_MAIL_FROM=platform-admin@brix.local
BRIX_PLATFORM_ADMIN_SETUP_TOKEN_TTL_SECONDS=86400
BRIX_PLATFORM_ADMIN_SETUP_RETURN_URL_FOR_DEV_ONLY=false
BRIX_PLATFORM_ADMIN_SETUP_LOGGING_NOTIFICATION_ENABLED=false

# Real SMTP delivery. Use provider-specific credentials; Gmail requires an app password.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# ---------------------- Super Admin Bootstrap ----------------------
BRIX_BOOTSTRAP_SUPER_ADMIN_ENABLED=true
BRIX_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BRIX_BOOTSTRAP_SUPER_ADMIN_USERNAME=Super Admin
BRIX_BOOTSTRAP_SUPER_ADMIN_SETUP_CODE=replace_with_strong_one_time_setup_code
BRIX_BOOTSTRAP_SUPER_ADMIN_SETUP_CODE_TTL_SECONDS=900
BRIX_BOOTSTRAP_SUPER_ADMIN_SESSION_TTL_SECONDS=300
