# ============================================================================
# Brix Platform — Environment Variable Configuration Template
# ============================================================================
#
# This file contains all required environment variables for the repository.
# Copy this file and fill in actual values for each environment (dev/test/prod).
#
# Version: 2.1.0
# Last Updated: 2026-03-25
#
# ============================================================================

# ============================================================================
# host-shell-standalone (产品模式运行壳后端)
# ============================================================================

# ------------- 安全配置 (必填) -------------

# JWT 签名密钥 (256位)
# 生成方式: openssl rand -base64 32
# 开发环境示例: tPlWjrt0Ea7wRUbqgzS5gykY3S+/BUYzsIwJUv4+WV0=
# 生产环境示例: +aETrV5eENDugr2RIQjMUT/c9J31TjDaBNebpK/IJTA=
JWT_SECRET=

# 网关签名密钥 (256位)
# 生成方式: openssl rand -base64 32
# 开发环境示例: uRgvfZCcbTZtZFc/z5V8ALuVz6K2dBv2Iwbq6U0uYPY=
# 生产环境示例: L6PxlsqrDmWH2ISkKnqFis5t0W73sJeaxljgJF01oWY=
GATEWAY_SIGNATURE_SECRET=

# CORS 允许的域名列表 (逗号分隔)
# 开发环境: http://localhost:3000,http://localhost:3001
# Production: https://app.brix.io,https://admin.brix.io
GATEWAY_ALLOWED_ORIGINS=

# ------------- 数据库配置 -------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brix_platform
POSTGRES_USER=brix
POSTGRES_PASSWORD=

# ------------- Redis 配置 -------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------- Kafka 配置 -------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================================================
# host-shell-embedded (嵌入模式运行壳 / 移动端)
# ============================================================================

# ------------- Google OAuth (必填) -------------

# Google OAuth Web 客户端 ID
# 获取方式: Google Cloud Console -> APIs & Services -> Credentials
# ⚠️ 禁止使用真实凭据作为示例值！
GOOGLE_WEB_CLIENT_ID=CHANGE-ME-google-oauth-client-id.apps.googleusercontent.com

# ------------- Android Release 签名 (生产必填) -------------

# keystore 文件路径 (相对于 android/ 目录)
RELEASE_STORE_FILE=brix-release.keystore

# keystore 密码
RELEASE_STORE_PASSWORD=

# 密钥别名
RELEASE_KEY_ALIAS=brix-key

# 密钥密码
RELEASE_KEY_PASSWORD=

# ------------- 开发环境配置 -------------

# 开发环境宿主机 IP
# Android 模拟器: 10.0.2.2
# Genymotion: 10.0.3.2
# 真机调试: 局域网 IP (如 192.168.x.x)
DEV_HOST_IP=10.0.2.2

# ============================================================================
# plugin-user-register (业务插件)
# ============================================================================

# ------------- API 认证 (生产必填) -------------

# 插件 API Key
# 生成方式: 使用 UUID 或随机字符串
PLUGIN_API_KEY=

# 插件 API Secret
# 生成方式: openssl rand -base64 32
PLUGIN_API_SECRET=

# ------------- Kafka 配置 (推荐) -------------

# Kafka 主题名
PLUGIN_KAFKA_TOPIC=platform.user.event

# Kafka 分区数 (推荐 >= 3)
PLUGIN_KAFKA_PARTITIONS=3

# Kafka 副本数 (推荐 >= 2)
PLUGIN_KAFKA_REPLICAS=2

# ------------- 插件数据库 -------------
PLUGIN_POSTGRES_HOST=localhost
PLUGIN_POSTGRES_PORT=5433
PLUGIN_POSTGRES_DB=plugin_user
PLUGIN_POSTGRES_USER=plugin_user
PLUGIN_POSTGRES_PASSWORD=

# ------------- MinIO 对象存储 -------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars

# ============================================================================
# 密钥生成脚本
# ============================================================================

# Windows PowerShell:
# $rng = New-Object System.Security.Cryptography.RNGCryptoServiceProvider
# $bytes = New-Object byte[] 32
# $rng.GetBytes($bytes)
# [Convert]::ToBase64String($bytes)

# Linux/macOS:
# openssl rand -base64 32

# ============================================================================
# Android keystore 生成命令
# ============================================================================

# Windows:
# & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v -storetype PKCS12 `
#   -keystore brix-release.keystore -alias brix-key `
#   -keyalg RSA -keysize 2048 -validity 10000 `
#   -storepass "YourPassword" -keypass "YourPassword" `
#   -dname "CN=Brix Platform, OU=Mobile Team, O=Brix Corp, L=Tokyo, ST=Tokyo, C=JP"

# Linux/macOS:
# keytool -genkeypair -v -storetype PKCS12 \
#   -keystore brix-release.keystore -alias brix-key \
#   -keyalg RSA -keysize 2048 -validity 10000 \
#   -storepass "YourPassword" -keypass "YourPassword" \
#   -dname "CN=Brix Platform, OU=Mobile Team, O=Brix Corp, L=Tokyo, ST=Tokyo, C=JP"
